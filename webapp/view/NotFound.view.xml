<mvc:View
	controllerName="LogTask.controller.NotFound"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">

    <Page>
        <content>
            <VBox
                class="sapUiSmallMargin"
                justifyContent="Center"
                alignItems="Center">

                <items>
                    <Text text="{i18n>notFoundText}" class="sapUiResponsiveMargin" />
                    <Button text="{i18n>navHomePageButtonText}" press="onClickHome" />
                </items>                        
            </VBox>
        </content>        
    </Page>
    
</mvc:View>