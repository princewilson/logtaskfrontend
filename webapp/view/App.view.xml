<mvc:View
	controllerName="LogTask.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true">
	<Shell>
		<App>
			 <pages>
			 	<Page id="app">
					<customHeader>
						<Bar design="Header" enableFlexBox="true">
							<contentLeft>																
								<Title text="LogTask" titleStyle="H6"/>
							</contentLeft>
							<contentMiddle>
								<Title text="{/headerTitle}">
									<layoutData>
										<FlexItemData alignSelf="Baseline" growFactor="1"  />
									</layoutData>
								</Title>								
							</contentMiddle>
							<contentRight>
								<core:HTML id="userButton" content="&lt;div id='clerk-user'&gt;&lt;/div&gt;"/>
							</contentRight>
						</Bar>
					</customHeader>
				</Page>
			 </pages>
		</App>
	</Shell>
</mvc:View>