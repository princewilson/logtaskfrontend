<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="createGoalDialog" title="{i18n>createGoalTitle}">
    <content>
      <Label text="{i18n>titleLabel}" />
      <Input id="createGoalTitleInput" placeholder="{i18n>titlePlaceholder}" />
      <Label text="{i18n>descriptionLabel}" />
      <TextArea id="createGoalDescriptionInput" placeholder="{i18n>descriptionPlaceholder}" rows="5" />
    </content>
    <beginButton>
      <Button text="{i18n>createButton}" press=".onCreateGoalDialogCreate" />
    </beginButton>
    <endButton>
      <Button text="{i18n>closeButton}" press=".onCreateGoalDialogClose" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>