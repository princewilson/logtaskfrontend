<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="deleteGoalDialog" type="Message" title="{i18n>confirmDeleteTitle}" class="centeredDialogTitle">
        <content>
            <Text text="{i18n>confirmDeleteMessage}" />
        </content>
        <beginButton>
            <Button text="{i18n>yesButton}" press=".onConfirmDeleteGoalYes" type="Emphasized" />
        </beginButton>
        <endButton>
            <Button text="{i18n>noButton}" press=".onConfirmDeleteGoalNo" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
