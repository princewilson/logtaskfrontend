<mvc:View controllerName="LogTask.controller.GoalsList"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc">
	<Page>
		<content>
			<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
				<!-- DynamicPage Content -->
				<f:content>
					<VBox fitContainer="true">
						<OverflowToolbar class="sapFDynamicPageAlignContent">
							<ToolbarSpacer/>
							<SearchField search=".onSearch" width="17.5rem"/>
							<OverflowToolbarButton icon="sap-icon://add" text="Add" type="Transparent" press=".onAddNewGoal" visible="{ui>/canCreate}"/>
						</OverflowToolbar>
						<Table id="goalsTable" inset="false" items="{
						path: 'goalsCurrent>/Goals',
						sorter: {
							path: 'title'
						}
					}" class="sapFDynamicPageAlignContent" width="auto">
							<columns>
								<Column width="12em">
									<Text text="Goals"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press=".onGoalsListItemPress">
									<cells>
										<ObjectIdentifier title="{goalsCurrent>title}" text="{goalsCurrent>description}"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>
				</f:content>
			</f:DynamicPage>
		</content>
	</Page>
</mvc:View>