{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "webapp",
    "baseUrl": "./",
    "types": [
      "openui5"
    ],
    "paths": {
      "ui5/walkthrough/*": [
        "webapp/*"
      ]
    }
  },
  "include": [
    "webapp/**/*"
  ]
}